{
	"name": "mcp-aggregator",
	"private": true,
	"description": "Builds a container image that presents multiple MCP servers as one Streamable HTTP endpoint. Dependencies are what the image installs; devDependencies are the build driver's own tooling.",
	"license": "MIT",
	"author": "Džiugas Eiva",
	"repository": "github:steelshot/mcp-aggregator",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"scripts": {
		"build": "node build.js",
		"login": "node build.js --login",
		"lint": "eslint ."
	},
	"dependencies": {
		"mcp-compress-router": "4.0.0",
		"supergateway": "4.2.0"
	},
	"overrides": {
		"undici": "8.12.3",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@modelcontextprotocol/sdk": "1.32.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"ajv": "8.20.0",
		"eslint": "10.13.0",
		"globals": "17.13.0",
		"liquidjs": "10.30.0"
	}
}
